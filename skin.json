{
	"name": "ForTraining",
	"version": "1.0",
	"author": "...",
	"url": "https://github.com/4training/mediawiki-skins-ForTraining",
	"descriptionmsg": "fortraining-desc",
	"namemsg": "skinname-fortraining",
	"license-name": "CC0-1.0",
	"type": "skin",
	"requires": {
		"MediaWiki": ">= 1.35.0"
	},
	"AutoloadClasses": {
		"ForTraining\\SkinForTraining": "SkinForTraining.php"
	},
	"ValidSkinNames": {
		"fortraining": {
			"class": "ForTraining\\SkinForTraining",
			"args": [ {
				"name": "fortraining",
				"responsive": true,
				"styles": [
					"skins.fortraining"
				],
				"messages": [
					"fortraining-logo-aria-label",
					"sitetitle",
					"search",
					"tagline",
					"navigation-heading"
				],
				"scripts": [
					"skins.fortraining.js"
				]
			} ]
		}
	},
	"MessagesDirs": {
		"ForTraining": [
			"i18n"
		]
	},
	"ResourceModules": {
		"skins.fortraining": {
			"class": "ResourceLoaderSkinModule",
			"features": {
				"normalize": true,
				"elements": true,
				"content": true,
				"interface": true,
				"logo": true
			},
			"styles": {
				"resources/screen-common.less": {
					"media": "screen"
				},
				"resources/screen-desktop.less": {
					"media": "screen and (min-width: 751px)"
				},
				"resources/screen-mobile.less": {
					"media": "screen and (max-width: 750px)"
				},
				"resources/print.css": {
					"media": "print"
				}
			}
		},
		"skins.fortraining.js": {
			"scripts": [
				"resources/main.js"
			]
		}
	},
	"ResourceFileModulePaths": {
		"localBasePath": "",
		"remoteSkinPath": "ForTraining"
	},
	"ResourceModuleSkinStyles": {
		"fortraining": {
			"+ext.echo.styles.badge": "resources/extensions/echo.styles.badge.less"
		}
	},
	"manifest_version": 1
}
